{
  "name": "report-via-mobile",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "generate:site-copy": "node scripts/generate-site-copy.mjs",
    "prebuild": "npm run generate:site-copy",
    "start": "ng serve",
    "build": "node scripts/build-with-normalized-ngsw.js",
    "normalize:ngsw": "node scripts/normalize-ngsw.js",
    "build:analyze": "node scripts/build-with-normalized-ngsw.js --configuration production,analyze",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:worker": "node --test worker/link-headers.test.mjs",
    "test:coverage": "ng test --coverage --watch=false",
    "quality": "npm run lint && npm run lint:styles && npm run test:coverage && npm run build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "22.1.4",
    "@angular/cdk": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/localize": "22.1.4",
    "@angular/material": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "@angular/service-worker": "22.1.4",
    "@fontsource/roboto": "^5.3.0",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.1.0",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "brace-expansion": "5.0.9",
    "undici": "7.29.0",
    "flatted": "3.4.2",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "path-to-regexp": "8.4.0",
    "picomatch": ">=2.3.2",
    "vite": "7.3.5",
    "fast-uri": "3.1.5",
    "sharp": "0.35.3",
    "qs": "6.15.2",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.1",
    "postcss": "8.5.23",
    "tar": "7.5.22",
    "@babel/core": "7.29.6",
    "piscina": "5.2.0",
    "nanoid": "3.3.18"
  }
}
