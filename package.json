{
  "name": "report-via-mobile",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/build-with-normalized-ngsw.js",
    "normalize:ngsw": "node scripts/normalize-ngsw.js",
    "build:analyze": "node scripts/build-with-normalized-ngsw.js --configuration production,analyze",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "21.2.11",
    "@angular/cdk": "21.2.9",
    "@angular/common": "21.2.11",
    "@angular/compiler": "21.2.11",
    "@angular/core": "21.2.11",
    "@angular/forms": "21.2.11",
    "@angular/localize": "21.2.11",
    "@angular/material": "21.2.9",
    "@angular/platform-browser": "21.2.11",
    "@angular/platform-browser-dynamic": "21.2.11",
    "@angular/router": "21.2.11",
    "@angular/service-worker": "21.2.11",
    "@fontsource/roboto": "^5.2.10",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.3.1",
    "@angular-eslint/eslint-plugin": "21.3.1",
    "@angular-eslint/eslint-plugin-template": "21.3.1",
    "@angular-eslint/template-parser": "21.3.1",
    "@angular/build": "21.2.9",
    "@angular/cli": "21.2.10",
    "@angular/compiler-cli": "21.2.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.4",
    "angular-eslint": "21.3.1",
    "eslint": "^10.3.0",
    "fast-check": "^4.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "stylelint": "^17.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "brace-expansion": "5.0.5",
    "undici": "7.24.2",
    "flatted": "3.4.2",
    "hono": "4.12.16",
    "ip-address": "10.1.1",
    "path-to-regexp": "8.4.0",
    "picomatch": ">=2.3.2",
    "vite": "7.3.2"
  }
}
